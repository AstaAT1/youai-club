# From your EmailJS dashboard (https://dashboard.emailjs.com/)
# These are public client-side identifiers, NOT secret API keys.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional but strongly recommended for public registrations:
# Google reCAPTCHA v2 CHECKBOX site key (public). Also activate reCAPTCHA v2
# verification in the EmailJS TEMPLATE SETTINGS with the Google SECRET key.
# NEVER place the reCAPTCHA secret key in this file.
VITE_RECAPTCHA_SITE_KEY=
